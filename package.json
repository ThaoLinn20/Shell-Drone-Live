{
  "name": "shell-drone-animation",
  "version": "3.3.1",
  "description": "Firework & Drone Show Studio",
  "author": "ThaoLinn20",
  "private": true,
  "type": "module",
  "main": "src/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "bridge": "node bridge/server.js thaolinn20",
    "live": "concurrently \"node bridge/server.js thaolinn20\" \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "live:desktop": "concurrently \"node bridge/server.js thaolinn20\" \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "live:web": "concurrently \"node bridge/server.js thaolinn20\" \"vite\"",
    "media:mute-previews": "node scripts/mute-preview-videos.js",
    "assets:slice-moons": "node scripts/slice-moons.js",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.fdlivestream.app",
    "productName": "FDLiveStream",
    "copyright": "Copyright © 2026 ThaoLinn20",
    "directories": {
      "output": "dist-electron"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "src/electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/icon2.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FDLiveStream",
      "displayLanguageSelector": true,
      "license": "LICENSE"
    }
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "vite": "^8.0.4",
    "vitest": "^4.1.9",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@shell-drone/firework-engine": "github:ThaoLinn20/firework-engine",
    "three": "^0.183.2",
    "tiktok-live-connector": "^2.5.0",
    "ws": "^8.22.1"
  }
}